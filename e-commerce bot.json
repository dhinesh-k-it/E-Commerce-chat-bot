    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT\n    o.order_id,\n    o.status,\n    o.expected_delivery,\n    o.order_date,\n    p.name AS product_name\nFROM orders o\nJOIN products p\n    ON p.product_id = o.product_id\nWHERE lower(o.order_id) = '{{ $fromAI(\"order_id\", \"Customer order ID such as ORD12345\", \"string\") }}'\nLIMIT 1;",
        "options": {}
      },
